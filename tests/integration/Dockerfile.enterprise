# Build a LOCAL Enterprise Odoo image for integration testing.
#
# Do not invoke this Dockerfile directly with a private checkout as its context:
# run.sh validates the official odoo/enterprise remote and version, exports only
# files tracked by the selected commit, and records that commit in image labels.
# Keep the resulting image private; it contains proprietary Enterprise source.
ARG ODOO_VERSION=19.0
FROM odoo:${ODOO_VERSION}

ARG ODOO_VERSION
ARG ODOO_ENTERPRISE_COMMIT
LABEL com.vodoo.odoo.version="${ODOO_VERSION}" \
      com.vodoo.odoo.edition="enterprise" \
      com.vodoo.enterprise.repository="https://github.com/odoo/enterprise" \
      com.vodoo.enterprise.commit="${ODOO_ENTERPRISE_COMMIT}"

USER root
COPY . /mnt/enterprise/
RUN chown -R odoo:odoo /mnt/enterprise
USER odoo
