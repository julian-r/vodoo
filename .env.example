# Odoo CLI Configuration Example
# Copy this file to .env or .odoo-cli.env and fill in your values

# Odoo instance URL (required)
ODOO_URL=https://your-odoo-instance.com

# Database name (required)
ODOO_DATABASE=your_database

# Username for authentication (required)
ODOO_USERNAME=your_username

# Password or API key (required unless ODOO_PASSWORD_REF is used)
ODOO_PASSWORD=your_password_or_api_key

# Optional: resolve password via secret reference (1Password CLI)
# ODOO_PASSWORD_REF=op://Vault/Item/password

# Optional: Default user whose partner is requested as the author of comments/notes
# Cross-user attribution requires an internal authenticated user. Odoo may reject or
# override it for share users, which can reliably use only their own partner.
# If not set, specify --author when adding comments/notes
# ODOO_DEFAULT_USER_ID=123

# Optional: Static HTTP headers (JSON object) for reverse proxies / Zero Trust gateways
# ODOO_HTTP_HEADERS={"X-Proxy-Token":"..."}

# Optional: Dynamic HTTP headers command
# Output mode "json": command prints {"Header":"value"} or {"headers": {...}, "expires_at": "..."}
# Output mode "token": command prints raw token text (mapped to ODOO_HTTP_HEADERS_CMD_HEADER)
# Cloudflare Zero Trust example (direct cloudflared command):
# ODOO_HTTP_HEADERS_CMD=cloudflared access token -app={ODOO_URL}
# ODOO_HTTP_HEADERS_CMD_OUTPUT=token
# ODOO_HTTP_HEADERS_CMD_HEADER=CF-Access-Token
# ODOO_HTTP_HEADERS_CMD_TIMEOUT=120
# Optional auto-login fallback (interactive):
# ODOO_HTTP_HEADERS_CMD=sh -lc "cloudflared access token -app={ODOO_URL} || (cloudflared access login {ODOO_URL} >/dev/null && cloudflared access token -app={ODOO_URL})"
# ODOO_HTTP_HEADERS_CACHE_BACKEND=keyring
# ODOO_HTTP_HEADERS_CACHE_KEY=optional-custom-cache-key
# ODOO_HTTP_HEADERS_CACHE_TTL=300

# Optional: Allow harmful operations (default: false)
# Harmful operations include posting public comments visible to customers
# Internal notes are always allowed as they are safe (not visible to customers)
# Set to 'true' to enable public comments
# ODOO_ALLOW_HARMFUL_OPERATIONS=false
